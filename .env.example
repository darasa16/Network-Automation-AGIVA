SECRET_KEY=agiva-super-secret-key-2026
PORT=5000
FLASK_ENV=development

# Super Admin Authentication (Khusus 1 Akun Super)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=agiva_admin123


# Database PostgreSQL cntoh ea
DATABASE_URL=postgresql://postgres:password@localhost:5432/agiva_noc_db

# Telegram Bot Alerting & Commands
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
NOC_TELEGRAM_CHAT_ID=-1001234567890

# Telegram Alerting Suppression Config (Anti-Spam / Anti-Bombardir)
# Set False agar grup Telegram TIDAK dibombardir oleh lonjakan fluktuasi sesaat (CPU, RAM, Latency, Loss)
TELEGRAM_ENABLE_EARLY_WARNING=False
# Khusus jika perangkat down total (HOST_DOWN), tetap kirim notifikasi segera (True/False)
TELEGRAM_IMMEDIATE_HOST_DOWN=True

# Polling & Backup APScheduler Config
POLLING_INTERVAL_MINUTES=2
BACKUP_CRON_HOUR=2
BACKUP_CRON_MINUTE=0

# Per-Device Credentials Vault
ROUTER_USER=rahasia lah
ROUTER_PASS=nah ini juga
HO_USER=nah ini juga nih
HO_PASS=ini apa lagi
